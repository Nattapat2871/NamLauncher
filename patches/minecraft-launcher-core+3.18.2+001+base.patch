+  getText (url, redirectCount = 0) {
+    return new Promise((resolve, reject) => {
+      const request = this.getTransport(url).get(this.requestOptions(url), response => {
+        const statusCode = response.statusCode || 0
+        const location = response.headers.location
+        if (statusCode >= 300 && statusCode < 400 && location && redirectCount < 5) {
+          response.resume()
+          return resolve(this.getText(new URL(location, url).href, redirectCount + 1))
+        }
+
+        const chunks = []
+        response.on('data', chunk => chunks.push(chunk))
+        response.on('end', () => resolve({
+          statusCode,
+          headers: response.headers,
+          body: Buffer.concat(chunks).toString('utf8')
+        }))
+      })
+      request.on('timeout', () => request.destroy(Object.assign(new Error('Request timed out'), { code: 'ETIMEDOUT' })))
+      request.on('error', reject)
+    })
+  }
+
+  getStatus (url) {
+    return new Promise(resolve => {
+      const request = this.getTransport(url).request({
+        ...this.requestOptions(url),
+        method: 'HEAD'
+      }, response => {
+        response.resume()
+        resolve(response.statusCode || 0)
+      })
+      request.on('timeout', () => request.destroy())
+      request.on('error', () => resolve(0))
+      request.end()
     })
   }
 
